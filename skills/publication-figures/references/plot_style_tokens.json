{
  "$schema": "publication-figures plot-style tokens v1",
  "compiled": "2026-05-18",
  "project": "publication-figures / [C] Data figures sub-project",
  "scope": "matplotlib rcParam presets emulating SigmaPlot, GraphPad Prism, and lab-recommended (Wong-palette) styles for biocatalysis figures.",
  "presets": {
    "sigmaplot": {
      "description": "Emulates SigmaPlot (Systat/Inpixon) Graph Defaults: Arial 9pt, 1.0pt axes, outward ticks, L-frame, monochrome cycle.",
      "rcParams": {
        "font.family": "Arial",
        "font.size": 9,
        "axes.titlesize": 10,
        "axes.titleweight": "normal",
        "axes.labelsize": 9,
        "axes.labelweight": "normal",
        "xtick.labelsize": 8,
        "ytick.labelsize": 8,
        "legend.fontsize": 8,
        "axes.linewidth": 1.0,
        "axes.spines.top": false,
        "axes.spines.right": false,
        "axes.spines.left": true,
        "axes.spines.bottom": true,
        "xtick.direction": "out",
        "ytick.direction": "out",
        "xtick.major.size": 4.0,
        "ytick.major.size": 4.0,
        "xtick.minor.size": 2.0,
        "ytick.minor.size": 2.0,
        "xtick.major.width": 1.0,
        "ytick.major.width": 1.0,
        "xtick.minor.width": 0.8,
        "ytick.minor.width": 0.8,
        "lines.linewidth": 1.5,
        "lines.markersize": 5,
        "lines.markeredgewidth": 1.0,
        "errorbar.capsize": 3.0,
        "legend.frameon": false,
        "legend.loc": "best",
        "axes.unicode_minus": false,
        "figure.dpi": 150,
        "savefig.dpi": 600,
        "pdf.fonttype": 42,
        "ps.fonttype": 42
      },
      "color_cycle": [
        "#000000",
        "#FF0000",
        "#0000FF",
        "#008000",
        "#800080",
        "#B45F00",
        "#808080",
        "#008080"
      ],
      "default_marker": "filled_circle",
      "marker_cycle": ["o", "s", "^", "v", "D", "<", ">", "P"],
      "fit_line_style": "solid",
      "error_bar_style": {
        "capsize_pt": 3.0,
        "elinewidth_pt": 1.0,
        "default_stat": "SD"
      },
      "sources": [
        "https://www.alfasoft.com/docs/sigmaplot-145-user-guide.pdf",
        "https://www.alfasoft.com/docs/sigmaplot-tutorial.pdf",
        "http://kfrserver.natur.cuni.cz/obecne/soubory/Sigmaplot/UserGuide.pdf",
        "https://systatsoftware.com/sigmaplot/graphing-features",
        "http://www.systat.de/TT201507/ErrorBarEN.pdf"
      ]
    },
    "prism": {
      "description": "Emulates GraphPad Prism defaults: Arial bold, 1.5pt axes, inward ticks, L-frame, multi-hue color cycle, prominent error caps.",
      "rcParams": {
        "font.family": "Arial",
        "font.size": 10,
        "axes.titlesize": 12,
        "axes.titleweight": "bold",
        "axes.labelsize": 10,
        "axes.labelweight": "bold",
        "xtick.labelsize": 9,
        "ytick.labelsize": 9,
        "legend.fontsize": 9,
        "axes.linewidth": 1.5,
        "axes.spines.top": false,
        "axes.spines.right": false,
        "axes.spines.left": true,
        "axes.spines.bottom": true,
        "xtick.direction": "in",
        "ytick.direction": "in",
        "xtick.major.size": 5.0,
        "ytick.major.size": 5.0,
        "xtick.minor.size": 3.0,
        "ytick.minor.size": 3.0,
        "xtick.major.width": 1.5,
        "ytick.major.width": 1.5,
        "xtick.minor.width": 1.0,
        "ytick.minor.width": 1.0,
        "lines.linewidth": 2.0,
        "lines.markersize": 6,
        "lines.markeredgewidth": 1.5,
        "errorbar.capsize": 4.0,
        "legend.frameon": false,
        "legend.loc": "best",
        "axes.unicode_minus": false,
        "figure.dpi": 150,
        "savefig.dpi": 600,
        "pdf.fonttype": 42,
        "ps.fonttype": 42
      },
      "color_cycle": [
        "#1E77B4",
        "#FF7F0E",
        "#2CA02C",
        "#D62728",
        "#9467BD",
        "#8C564B",
        "#E377C2",
        "#7F7F7F",
        "#BCBD22",
        "#17BECF"
      ],
      "default_marker": "filled_circle",
      "marker_cycle": ["o", "s", "^", "D", "v", "P", "X", "*"],
      "fit_line_style": "solid",
      "error_bar_style": {
        "capsize_pt": 4.0,
        "elinewidth_pt": 1.5,
        "default_stat": "SEM"
      },
      "significance_markers": {
        "p_0.05": "*",
        "p_0.01": "**",
        "p_0.001": "***",
        "p_0.0001": "****",
        "not_significant": "ns",
        "bracket_used": true
      },
      "alt_palettes": {
        "comment": "Names mirror Prism schemes. Exact HEX is proprietary; ggprism package reproduces them via R binary data. Install ggprism to retrieve; here we record the names and known sizes.",
        "colors_default": {"size": 20, "comment": "Prism default for new graphs"},
        "floral": {"size": 12},
        "pastels": {"size": 9},
        "warm_pastels": {"size": 9},
        "prism_dark": {"size": 10},
        "prism_light": {"size": 10},
        "blueprint": {"size": 9},
        "candy_bright": {"size": 9},
        "viridis": {"size": 6},
        "starry_example_4": ["#000000", "#042E3D", "#765A22", "#44726D"]
      },
      "sources": [
        "https://www.graphpad.com/guides/prism/latest/user-guide/fonts.htm",
        "https://www.graphpad.com/guides/prism/latest/user-guide/formataxes.htm",
        "https://www.graphpad.com/guides/prism/latest/user-guide/axis_numbering.htm",
        "https://www.graphpad.com/guides/prism/latest/user-guide/colors.htm",
        "https://www.graphpad.com/support/faq/standardizing-prism-preferences/",
        "https://www.graphpad.com/support/faq/prism-color-schemes/",
        "https://cran.r-project.org/web/packages/ggprism/vignettes/themes.html",
        "https://csdaw.github.io/ggprism/articles/colours.html",
        "https://csdaw.github.io/ggprism/reference/prism_colour_pal.html"
      ]
    },
    "recommended": {
      "description": "Recommended default: hybrid of SigmaPlot frame minimalism and Prism font discipline, with Wong (Okabe-Ito) colorblind-safe palette.",
      "rcParams": {
        "font.family": "Arial",
        "font.size": 9,
        "axes.titlesize": 10,
        "axes.titleweight": "normal",
        "axes.labelsize": 9,
        "axes.labelweight": "normal",
        "xtick.labelsize": 8,
        "ytick.labelsize": 8,
        "legend.fontsize": 8,
        "axes.linewidth": 1.0,
        "axes.spines.top": false,
        "axes.spines.right": false,
        "axes.spines.left": true,
        "axes.spines.bottom": true,
        "xtick.direction": "out",
        "ytick.direction": "out",
        "xtick.major.size": 4.0,
        "ytick.major.size": 4.0,
        "xtick.minor.size": 2.0,
        "ytick.minor.size": 2.0,
        "xtick.major.width": 1.0,
        "ytick.major.width": 1.0,
        "xtick.minor.width": 0.8,
        "ytick.minor.width": 0.8,
        "lines.linewidth": 1.5,
        "lines.markersize": 5,
        "lines.markeredgewidth": 1.0,
        "errorbar.capsize": 3.0,
        "legend.frameon": false,
        "legend.loc": "best",
        "axes.unicode_minus": false,
        "figure.dpi": 150,
        "savefig.dpi": 600,
        "pdf.fonttype": 42,
        "ps.fonttype": 42
      },
      "color_cycle": [
        "#000000",
        "#E69F00",
        "#56B4E9",
        "#009E73",
        "#F0E442",
        "#0072B2",
        "#D55E00",
        "#CC79A7"
      ],
      "color_cycle_name": "Wong / Okabe-Ito (Nature Methods 2011)",
      "default_marker": "filled_circle",
      "marker_cycle": ["o", "s", "^", "D", "v", "P", "X", "*"],
      "fit_line_style": "solid",
      "error_bar_style": {
        "capsize_pt": 3.0,
        "elinewidth_pt": 1.0,
        "default_stat": "SD"
      },
      "rationale": "Outward ticks (more readable in print than Prism's inward); 1.0pt axes (Prism's 1.5pt looks heavy at 4-inch single-column scale); Wong palette (colorblind-safe and peer-reviewed); legend frameless (universal modern convention).",
      "sources": [
        "https://doi.org/10.1038/nmeth.1618",
        "https://mk.bcgsc.ca/colorblind/palettes.mhtml",
        "https://www.graphpad.com/guides/prism/latest/user-guide/fonts.htm",
        "https://www.alfasoft.com/docs/sigmaplot-145-user-guide.pdf"
      ]
    }
  },
  "figure_type_routing": {
    "kinetic_time_course_single": "recommended",
    "kinetic_time_course_multi": "recommended",
    "hplc_chromatogram": "sigmaplot",
    "dose_response": "prism",
    "ph_rate": "prism",
    "bo_surface_contour": "recommended",
    "bar_with_error": "prism",
    "pareto_front": "recommended"
  },
  "notes": {
    "pdf_fonttype_42": "Forces TrueType embedding in PDF/PS so journals can re-edit text",
    "axes_unicode_minus_false": "Use ASCII '-' instead of Unicode minus for cross-platform consistency",
    "savefig_dpi_600": "Journal-ready raster; figures should still ideally be exported as PDF/SVG vector",
    "marker_cycle_separate": "matplotlib does not chain marker cycles to color cycle by default; we add manually in lab_plot.py via cycler product"
  },
  "consolidated_sources": [
    "https://www.graphpad.com/guides/prism/latest/user-guide/fonts.htm",
    "https://www.graphpad.com/guides/prism/latest/user-guide/formataxes.htm",
    "https://www.graphpad.com/guides/prism/latest/user-guide/axis_numbering.htm",
    "https://www.graphpad.com/guides/prism/latest/user-guide/colors.htm",
    "https://www.graphpad.com/guides/prism/latest/user-guide/using_changing_a_graphs_colors.htm",
    "https://www.graphpad.com/guides/prism/latest/user-guide/prism_magic_apply_style_from_an_example.htm",
    "https://www.graphpad.com/support/faq/standardizing-prism-preferences/",
    "https://www.graphpad.com/support/faq/prism-color-schemes/",
    "https://cran.r-project.org/web/packages/ggprism/vignettes/themes.html",
    "https://csdaw.github.io/ggprism/articles/colours.html",
    "https://csdaw.github.io/ggprism/reference/prism_colour_pal.html",
    "https://www.alfasoft.com/docs/sigmaplot-145-user-guide.pdf",
    "https://www.alfasoft.com/docs/sigmaplot-tutorial.pdf",
    "http://kfrserver.natur.cuni.cz/obecne/soubory/Sigmaplot/UserGuide.pdf",
    "https://systatsoftware.com/sigmaplot/graphing-features",
    "http://www.systat.de/TT201507/ErrorBarEN.pdf",
    "https://doi.org/10.1038/nmeth.1618",
    "https://mk.bcgsc.ca/colorblind/palettes.mhtml",
    "https://www.graphpad.com/guides/prism/latest/curve-fitting/reg_example_enzyme_kinetics.htm",
    "https://holdsworthwiki.robarts.ca/files/graphpad_prism/prismexamples.pdf",
    "https://iubmb.onlinelibrary.wiley.com/doi/full/10.1002/bmb.21823",
    "https://home.sandiego.edu/~josephprovost/Biochem%20Lab%20GraphPad%20Prism%20Kinetics%20Instructions%20F21.pdf",
    "https://www.pharmaceuticalonline.com/doc/product-sheet-sigmaplot-mdash-enzyme-kinetics-0001",
    "https://pmc.ncbi.nlm.nih.gov/articles/PMC11165005/",
    "https://pubs.rsc.org/en/content/articlehtml/2024/cs/d3cs00595j"
  ]
}
